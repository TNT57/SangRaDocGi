{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".vercel", "node_modules", "playwright-report", "test-results"],
  "compilerOptions": {
    "jsx": "react-jsx",
