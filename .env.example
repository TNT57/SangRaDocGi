# Copy to .env for local work. Never commit real values.

# Public site address (used for canonical links).
SITE_URL=https://ket-sach.vercel.app

# Counter (CLAUDE.md §6.3). Upstash Redis REST credentials.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Random string used to hash visitor IPs before rate limiting (IPs are never stored).
COUNTER_SALT=

# Analytics (CLAUDE.md §10). GoatCounter site code, e.g. "ketsach" for ketsach.goatcounter.com.
# Leave empty to turn analytics off.
PUBLIC_GOATCOUNTER_CODE=

# Set to 1 to include draft readings in a build (preview only, never production).
INCLUDE_DRAFTS=
